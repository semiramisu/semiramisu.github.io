---
import BaseLayout from "../layouts/BaseLayout.astro";
import PathBreadcrumb from "../components/PathBreadcrumb.astro";
import Icon from "../components/Icon.astro";
import { SITE } from "../site.config";
---

<BaseLayout title="Contact" description="お問い合わせフォーム">
  <div class="container contact-page">
    <PathBreadcrumb segments={[{ label: "contact" }]} />
    <h1 class="prompt page-title">contact --new</h1>

    <p id="sent-message" class="sent-message mono" hidden>
      ✓ 送信しました。ありがとうございます！
    </p>

    <form
      name="contact"
      method="POST"
      action="/contact/?sent=1"
      data-netlify="true"
      netlify-honeypot="bot-field"
      class="contact-form"
    >
      <input type="hidden" name="form-name" value="contact" />
      <p class="hidden-field">
        <label>Don't fill this out: <input name="bot-field" /></label>
      </p>

      <div class="field">
        <label for="name" class="mono" data-i18n="contact.name">お名前</label>
        <input type="text" id="name" name="name" required autocomplete="name" />
      </div>

      <div class="field">
        <label for="email" class="mono" data-i18n="contact.email">メールアドレス</label>
        <input type="email" id="email" name="email" required autocomplete="email" />
      </div>

      <div class="field">
        <label for="subject" class="mono" data-i18n="contact.subject">件名</label>
        <input type="text" id="subject" name="subject" required />
      </div>

      <div class="field">
        <label for="message" class="mono" data-i18n="contact.message">メッセージ</label>
        <textarea id="message" name="message" rows="8" required></textarea>
      </div>

      <button type="submit" class="mono submit-button">
        $ <span data-i18n="contact.send">送信</span>
      </button>
    </form>

    <div class="alt-contacts mono">
      <p class="comment-line">// または</p>
      <a href={SITE.x} target="_blank" rel="noopener"><Icon name="x" size={16} /> @sekine_DS</a>
      <a href={SITE.github} target="_blank" rel="noopener"><Icon name="github" size={16} /> GitHub</a>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-page {
    padding-block: 2rem 4rem;
    max-width: 44rem;
  }

  .page-title {
    margin-block: 1.5rem 2rem;
  }

  .sent-message {
    color: var(--accent);
    margin-bottom: 1.5rem;
  }

  .contact-form {
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
  }

  .hidden-field {
    display: none;
  }

  .field {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .field label {
    font-size: var(--text-sm);
    color: var(--text-secondary);
  }

  .field input,
  .field textarea {
    background-color: var(--bg-surface);
    border: 1px solid var(--border-strong);
    border-radius: 6px;
    padding: 0.55rem 0.8rem;
    color: var(--text-primary);
  }

  .field input:focus,
  .field textarea:focus {
    outline: 2px solid var(--focus-ring);
    outline-offset: 0;
    border-color: transparent;
  }

  .submit-button {
    align-self: flex-start;
    background-color: var(--accent);
    color: var(--accent-text-on);
    font-weight: 700;
    border-radius: 6px;
    padding: 0.55rem 1.6rem;
  }

  .submit-button:hover {
    background-color: var(--accent-hover);
  }

  .alt-contacts {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    margin-top: 2.5rem;
    font-size: var(--text-sm);
  }

  .alt-contacts a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--text-secondary);
  }

  .alt-contacts a:hover {
    color: var(--accent);
  }
</style>

<script>
  if (new URLSearchParams(location.search).has("sent")) {
    document.getElementById("sent-message")?.removeAttribute("hidden");
  }
</script>
