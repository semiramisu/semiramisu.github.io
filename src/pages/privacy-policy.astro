---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PathBreadcrumb from "../components/PathBreadcrumb.astro";

const policy = await getEntry("specs", "privacy-policy");
if (!policy) throw new Error("specs/privacy-policy.md not found");
const { Content } = await render(policy);
---

<BaseLayout title="プライバシーポリシー" description={policy.data.description}>
  <div class="container spec-page">
    <PathBreadcrumb segments={[{ label: "privacy-policy.md" }]} />
    <h1 class="prompt page-title">cat ~/privacy-policy.md</h1>
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .spec-page {
    padding-block: 2rem 4rem;
  }

  .page-title {
    margin-block: 1.5rem 2rem;
  }
</style>
