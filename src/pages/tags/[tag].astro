---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PathBreadcrumb from "../../components/PathBreadcrumb.astro";
import PostList from "../../components/PostList.astro";
import { getPublishedPosts, countTags } from "../../utils/content";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // raw tag names (may contain spaces, e.g. "Claude Code") as in the old site
  return [...countTags(posts).keys()].map((tag) => ({
    params: { tag },
    props: { posts: posts.filter((p) => p.data.tags.includes(tag)) },
  }));
}

const { tag } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`タグ: ${tag}`}>
  <div class="container list-page">
    <PathBreadcrumb segments={[{ label: "tags", href: "/tags/" }, { label: tag! }]} />
    <h1 class="prompt page-title">grep -rl "#{tag}" ~/posts</h1>
    <p class="comment-line">// {posts.length} posts</p>
    <div class="timeline-wrap">
      <PostList posts={posts} variant="timeline" />
    </div>
  </div>
</BaseLayout>

<style>
  .list-page {
    padding-block: 2rem 4rem;
  }

  .page-title {
    margin-block: 1.5rem 0.4rem;
  }

  .timeline-wrap {
    margin-top: 2rem;
  }
</style>
