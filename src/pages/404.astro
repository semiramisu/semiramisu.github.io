---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="404 Not Found">
  <div class="container notfound">
    <img
      src="/images/kairo-sad.webp"
      alt=""
      width="122"
      height="149"
      class="sad-kairo"
    />
    <p class="kicker">Missing Issue</p>
    <p class="big display" aria-hidden="true">
      <span>4</span><span>0</span><span>4</span>
    </p>
    <h1 class="lead" data-i18n="notfound.lead">お探しのページは欠番です。</h1>
    <p class="meta-line path-line">
      <span id="requested-path"></span>
      <span data-i18n="notfound.message">ページが見つかりませんでした</span>
    </p>

    <div class="actions">
      <a href="/" class="action" data-i18n="notfound.home">ホームへ戻る</a>
      <a href="/archive/" class="action" data-i18n="notfound.archive"
        >記事一覧を見る</a
      >
      <a href="/search/" class="action" data-i18n="action.search">検索</a>
    </div>
  </div>
</BaseLayout>

<style>
  .notfound {
    padding-block: 5rem 6rem;
    text-align: center;
  }

  .sad-kairo {
    width: 7.6rem;
    height: auto;
    margin: 0 auto -1rem;
    image-rendering: pixelated;
    transform-origin: 50% 100%;
    animation: sad-wobble 2.8s ease-in-out infinite;
  }

  @keyframes sad-wobble {
    0%,
    100% {
      transform: rotate(-2deg) translateY(0);
    }
    50% {
      transform: rotate(2deg) translateY(-0.35rem);
    }
  }

  /* the missing issue number, stamped in category inks */
  .big {
    font-size: clamp(6rem, 3rem + 18vw, 13rem);
    line-height: 1;
    margin-top: 0.5rem;
    letter-spacing: 0.02em;
  }

  .big span:nth-child(1) {
    color: var(--cat-work);
  }

  .big span:nth-child(2) {
    color: var(--accent);
  }

  .big span:nth-child(3) {
    color: var(--cat-book);
  }

  .lead {
    margin-top: 1.5rem;
    font-size: var(--text-xl);
    font-weight: 800;
  }

  .path-line {
    margin-top: 0.8rem;
  }

  #requested-path {
    overflow-wrap: anywhere;
  }

  #requested-path:not(:empty)::after {
    content: " — ";
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.8rem;
    margin-top: 2.5rem;
  }

  .action {
    padding: 0.5rem 1.4rem;
    border: 2px solid var(--border-strong);
    border-radius: var(--radius-sm);
    background: var(--bg-elevated);
    box-shadow: 2px 2px 0 var(--rule-ink);
    font-size: var(--text-sm);
    font-weight: 700;
    color: var(--text-secondary);
  }

  .action:hover {
    color: var(--accent);
    border-color: var(--accent);
  }
</style>

<script>
  const el = document.getElementById("requested-path");
  if (el) el.textContent = location.pathname;
</script>
