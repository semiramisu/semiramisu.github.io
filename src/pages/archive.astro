---
import BaseLayout from "../layouts/BaseLayout.astro";
import PathBreadcrumb from "../components/PathBreadcrumb.astro";
import PageHeader from "../components/PageHeader.astro";
import PostList from "../components/PostList.astro";
import { getPublishedPosts } from "../utils/content";

const posts = await getPublishedPosts();
---

<BaseLayout title="アーカイブ">
  <div class="container list-page">
    <PathBreadcrumb segments={[{ label: "posts" }]} />
    <PageHeader kicker="Archive" title="アーカイブ" count={posts.length} />
    <div class="timeline-wrap">
      <PostList posts={posts} variant="timeline" />
    </div>
  </div>
</BaseLayout>

<style>
  .list-page {
    padding-block: 2rem 4rem;
  }

  .timeline-wrap {
    margin-top: 2.5rem;
  }
</style>
