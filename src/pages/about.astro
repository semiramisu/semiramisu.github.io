---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PathBreadcrumb from "../components/PathBreadcrumb.astro";
import { SITE } from "../site.config";

const about = await getEntry("specs", "about");
if (!about) throw new Error("specs/about.md not found");
const { Content } = await render(about);
---

<BaseLayout title="About" description={`${SITE.author}について`}>
  <div class="container spec-page">
    <PathBreadcrumb segments={[{ label: "about" }]} />

    <header class="profile">
      <img src="/icon.jpg" alt={`${SITE.author}のアバター`} width="96" height="96" class="avatar" loading="lazy" />
      <div class="profile-text">
        <p class="kicker">About</p>
        <h1 class="name">{SITE.author}</h1>
        <p class="kicker sign">{SITE.sign}</p>
      </div>
    </header>

    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .spec-page {
    padding-block: 2rem 4rem;
  }

  /* editorial profile header framed by heavy rules */
  .profile {
    display: flex;
    align-items: center;
    gap: 1.75rem;
    margin-top: 1.5rem;
    margin-bottom: 2.5rem;
    padding-block: 1.75rem;
    border-top: 3px solid var(--rule-ink);
    border-bottom: 1px solid var(--border-subtle);
  }

  .avatar {
    border-radius: 50%;
    border: 2px solid var(--border-strong);
  }

  .name {
    margin-top: 0.2rem;
    font-size: var(--display-page);
    font-weight: 800;
    line-height: 1.2;
  }

  .sign {
    margin-top: 0.5rem;
    color: var(--text-muted);
  }

  .spec-page .prose {
    margin-inline: 0;
  }
</style>
