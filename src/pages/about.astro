---
import { getEntry, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import PathBreadcrumb from "../components/PathBreadcrumb.astro";
import { SITE } from "../site.config";

const about = await getEntry("specs", "about");
if (!about) throw new Error("specs/about.md not found");
const { Content } = await render(about);
---

<BaseLayout title="About" description={`${SITE.author}について`}>
  <div class="container spec-page">
    <PathBreadcrumb segments={[{ label: "about.md" }]} />
    <h1 class="prompt page-title">cat ~/about.md</h1>
    <div class="profile">
      <img src="/icon.jpg" alt={`${SITE.author}のアバター`} width="72" height="72" class="avatar" loading="lazy" />
      <div>
        <p class="mono name">{SITE.author}</p>
        <p class="comment-line">// {SITE.sign}</p>
      </div>
    </div>
    <div class="prose">
      <Content />
    </div>
  </div>
</BaseLayout>

<style>
  .spec-page {
    padding-block: 2rem 4rem;
  }

  .page-title {
    margin-block: 1.5rem 2rem;
  }

  .profile {
    display: flex;
    align-items: center;
    gap: 1.25rem;
    margin-bottom: 2.5rem;
  }

  .avatar {
    border-radius: 50%;
    border: 2px solid var(--border-strong);
  }

  .name {
    font-weight: 700;
    font-size: var(--text-lg);
  }

  .spec-page .prose {
    margin-inline: 0;
  }
</style>
