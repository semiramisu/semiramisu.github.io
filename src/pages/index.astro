---
import BaseLayout from "../layouts/BaseLayout.astro";
import PostCard from "../components/PostCard.astro";
import SectionHeader from "../components/SectionHeader.astro";
import NewsletterForm from "../components/NewsletterForm.astro";
import { SITE } from "../site.config";
import { getPublishedPosts, countCategories } from "../utils/content";
import { getCategoryGroup, filterByGroup, type CatKey } from "../utils/categories";

const posts = await getPublishedPosts();

// The front page covers exactly the first 6 posts (feature 3 + latest 3),
// matching the old page-1 range so /2/ continues seamlessly from here.
const heroPost = posts[0];
const featuredPosts = posts.slice(1, 3);
const latestPosts = posts.slice(3, 6);

const categories = countCategories(posts);

// Magazine sections: the four big categories plus the aggregated tech cluster.
// Category URLs and labels stay raw; only the section curation is grouped.
const exactSections = ["仕事", "雑談", "読書", "休日"] as const;
const sections = [
  ...exactSections.map((name) => ({
    name,
    catKey: getCategoryGroup(name),
    href: `/categories/${name}/`,
    posts: posts.filter((p) => p.data.category === name).slice(0, 4),
    count: categories.get(name) ?? 0,
  })),
  {
    name: "テック",
    catKey: "tech" as CatKey,
    href: "/categories/",
    posts: filterByGroup(posts, "tech").slice(0, 4),
    count: filterByGroup(posts, "tech").length,
  },
].filter((section) => section.posts.length > 0);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: SITE.title,
  description: SITE.description,
  url: new URL("/", Astro.site).toString(),
  author: { "@type": "Person", name: SITE.author },
  inLanguage: "ja",
};
---

<BaseLayout>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(jsonLd)} is:inline />

  <div class="container">
    <section class="masthead">
      <p class="kicker masthead-sub">Semiramis Garden — {SITE.sign}</p>
      <h1 class="masthead-title">{SITE.title}</h1>
      <p class="masthead-intro" data-i18n="hero.intro">
        セミラミスです。データサイエンスの仕事、読んだ本、日々考えたことを、親友に話すみたいに書いています。
      </p>
    </section>

    <section class="feature" aria-label="特集">
      <hr class="rule-heavy" />
      <p class="kicker feature-kicker">Feature</p>
      <div class="feature-grid">
        <PostCard post={heroPost} variant="hero" />
        <div class="feature-rail">
          {featuredPosts.map((post) => <PostCard post={post} variant="featured" />)}
        </div>
      </div>
    </section>

    <section class="latest">
      <SectionHeader kicker="Latest" title="最新の記事" titleI18n="home.latest" />
      <div class="card-grid">
        {latestPosts.map((post) => <PostCard post={post} variant="standard" />)}
      </div>
      <p class="latest-more">
        <a href="/2/" class="more-link"><span data-i18n="home.nextPage">続きの記事へ</span> →</a>
        <a href="/archive/" class="more-link secondary">
          <span data-i18n="list.viewAll">すべての記事を見る</span> ({posts.length})
        </a>
      </p>
    </section>
  </div>

  <div class="section-band">
    <div class="container">
      {
        sections.map((section) => (
          <section class="cat-section">
            <SectionHeader
              kicker="Category"
              title={section.name}
              count={section.count}
              href={section.href}
              catKey={section.catKey}
            />
            <div class="cat-grid">
              <PostCard post={section.posts[0]} variant="standard" />
              <div class="cat-rail">
                {section.posts.slice(1).map((post) => (
                  <PostCard post={post} variant="compact" />
                ))}
              </div>
            </div>
          </section>
        ))
      }
    </div>
  </div>

  <div class="container">
    <section class="all-categories">
      <SectionHeader kicker="Index" title="カテゴリから探す" titleI18n="home.byCategory" />
      <ul class="category-chips">
        {
          [...categories].map(([name, count]) => (
            <li data-cat={getCategoryGroup(name)}>
              <a href={`/categories/${name}/`} class="chip chip--cat">
                {name} <span class="chip-count">{count}</span>
              </a>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="newsletter-band">
      <NewsletterForm />
    </section>
  </div>
</BaseLayout>

<style>
  /* ---------- masthead ---------- */
  .masthead {
    padding-block: 3.5rem 2.5rem;
    text-align: center;
  }

  .masthead-sub {
    color: var(--text-muted);
  }

  .masthead-title {
    margin-top: 0.5rem;
    font-size: clamp(2.4rem, 1.5rem + 4vw, 4rem);
    font-weight: 800;
    line-height: 1.2;
    letter-spacing: 0.04em;
  }

  .masthead-intro {
    margin: 1.25rem auto 0;
    max-width: 34em;
    font-size: var(--text-base);
    color: var(--text-secondary);
    line-height: 1.9;
  }

  /* ---------- feature ---------- */
  .feature-kicker {
    display: block;
    padding-top: 0.8rem;
  }

  .feature-grid {
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
  }

  .feature-rail {
    display: grid;
    gap: 1.5rem;
    align-content: start;
  }

  @media (min-width: 960px) {
    .feature-grid {
      grid-template-columns: 2fr 1fr;
      gap: 2.5rem;
    }
  }

  /* ---------- latest ---------- */
  .latest {
    margin-top: 3.5rem;
  }

  .card-grid {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.5rem;
  }

  @media (min-width: 640px) {
    .card-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (min-width: 960px) {
    .card-grid {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  .latest-more {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 2rem;
    justify-content: flex-end;
    margin-top: 2rem;
    font-size: var(--text-sm);
  }

  .more-link {
    font-weight: 700;
    color: var(--text-primary);
  }

  .more-link:hover {
    color: var(--accent);
  }

  .more-link.secondary {
    font-weight: 400;
    color: var(--text-secondary);
  }

  /* ---------- category sections (surface band = reprint zone) ---------- */
  .section-band {
    margin-top: 4rem;
    padding-block: 3rem 3.5rem;
    background-color: var(--bg-surface);
  }

  .cat-section {
    margin-top: 3rem;
  }

  .cat-section:first-child {
    margin-top: 0;
  }

  .cat-grid {
    display: grid;
    gap: 1.75rem;
    margin-top: 1.5rem;
  }

  .cat-rail {
    align-content: start;
  }

  @media (min-width: 768px) {
    .cat-grid {
      grid-template-columns: 1fr 1fr;
      gap: 2.5rem;
    }
  }

  /* ---------- category chips ---------- */
  .all-categories {
    margin-top: 4rem;
  }

  .category-chips {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .chip-count {
    opacity: 0.65;
    font-size: var(--text-xs);
  }

  /* ---------- newsletter ---------- */
  .newsletter-band {
    margin-top: 3rem;
    margin-bottom: 1rem;
  }
</style>
