---
import BaseLayout from "../../layouts/BaseLayout.astro";
import PathBreadcrumb from "../../components/PathBreadcrumb.astro";
import PageHeader from "../../components/PageHeader.astro";
import PostList from "../../components/PostList.astro";
import { getPublishedPosts, countCategories } from "../../utils/content";
import { getCategoryGroup } from "../../utils/categories";

export async function getStaticPaths() {
  const posts = await getPublishedPosts();
  // raw Japanese category names as params, matching the old URL scheme
  return [...countCategories(posts).keys()].map((category) => ({
    params: { category },
    props: { posts: posts.filter((p) => p.data.category === category) },
  }));
}

const { category } = Astro.params;
const { posts } = Astro.props;
---

<BaseLayout title={`カテゴリ: ${category}`}>
  <div class="container list-page">
    <PathBreadcrumb
      segments={[{ label: "categories", href: "/categories/" }, { label: category! }]}
    />
    <PageHeader
      kicker="Category"
      title={category!}
      count={posts.length}
      catKey={getCategoryGroup(category)}
    />
    <div class="timeline-wrap">
      <PostList posts={posts} variant="timeline" />
    </div>
  </div>
</BaseLayout>

<style>
  .list-page {
    padding-block: 2rem 4rem;
  }

  .timeline-wrap {
    margin-top: 2.5rem;
  }
</style>
