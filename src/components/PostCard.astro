---
import type { Post } from "../utils/content";
import { formatDate } from "../utils/content";
import { getCategoryGroup } from "../utils/categories";

interface Props {
  post: Post;
  /**
   * hero: side-by-side feature card (home top slot)
   * featured: stacked card with a short plate (home feature rail)
   * standard: plate + title + lead, the 3-column grid unit
   * compact: plateless row — date, color dot, title
   */
  variant?: "hero" | "featured" | "standard" | "compact";
}

const { post, variant = "standard" } = Astro.props;
const href = `/posts/${post.id}/`;
const cat = getCategoryGroup(post.data.category);
// some old posts have description identical to the title — showing it twice is noise
const description =
  post.data.description && post.data.description !== post.data.title
    ? post.data.description
    : undefined;

// 85% of posts have no image, so the visual is a typographic plate:
// the day as a huge numeral, month/year as a kicker, category as the imprint.
const MONTHS = ["JAN", "FEB", "MAR", "APR", "MAY", "JUN", "JUL", "AUG", "SEP", "OCT", "NOV", "DEC"];
const published = post.data.published;
const day = String(published.getDate()).padStart(2, "0");
const monthYear = `${MONTHS[published.getMonth()]} ${published.getFullYear()}`;
---

<article class:list={["post-card", variant]} data-cat={cat}>
  <a href={href} class="card-link">
    {
      variant !== "compact" && (
        <div class="plate" aria-hidden="true">
          <span class="plate-month display">{monthYear}</span>
          <span class="plate-day display">{day}</span>
          {post.data.category && <span class="plate-cat">{post.data.category}</span>}
        </div>
      )
    }
    <div class="card-body">
      {
        variant === "compact" ? (
          <>
            <time class="compact-date" datetime={published.toISOString()}>
              {formatDate(published)}
            </time>
            <span class="cat-dot" aria-hidden="true" />
            <span class="title">{post.data.title}</span>
          </>
        ) : (
          <>
            <h3 class="title">{post.data.title}</h3>
            {description && <p class="lead">{description}</p>}
            <p class="meta-line">
              <time datetime={published.toISOString()}>{formatDate(published)}</time>
              {post.data.category && <span class="meta-cat">{post.data.category}</span>}
            </p>
          </>
        )
      }
    </div>
  </a>
</article>

<style>
  .post-card {
    position: relative;
  }

  .card-link {
    display: block;
    height: 100%;
    color: inherit;
  }

  .card-link:hover {
    color: inherit;
  }

  /* ---------- typographic plate (the image stand-in) ---------- */
  .plate {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    aspect-ratio: 16 / 9;
    background-color: color-mix(in oklab, var(--cat, var(--accent)) 12%, var(--bg-elevated));
    border-radius: var(--radius-sm);
    overflow: hidden;
  }

  .plate-month {
    font-size: var(--kicker-size);
    letter-spacing: 0.14em;
    color: var(--cat, var(--accent));
  }

  .plate-day {
    font-size: clamp(2.6rem, 2rem + 2vw, 3.6rem);
    line-height: 1.1;
    color: color-mix(in oklab, var(--cat, var(--accent)) 38%, transparent);
  }

  .plate-cat {
    position: absolute;
    right: 0.7rem;
    bottom: 0.5rem;
    font-size: var(--text-xs);
    font-weight: 700;
    color: var(--cat, var(--accent));
  }

  /* ---------- body ---------- */
  .card-body {
    padding: 0.9rem 0.15rem 0;
  }

  .title {
    font-size: var(--text-lg);
    font-weight: 800;
    line-height: 1.5;
    color: var(--text-primary);
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .card-link:hover .title {
    text-decoration: underline;
    text-underline-offset: 0.22em;
    text-decoration-thickness: 2px;
    text-decoration-color: var(--cat, var(--accent));
  }

  .lead {
    margin: 0.45rem 0 0;
    font-size: var(--text-sm);
    line-height: 1.7;
    color: var(--text-secondary);
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .meta-line {
    margin: 0.55rem 0 0;
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    font-variant-numeric: tabular-nums;
  }

  .meta-cat {
    font-weight: 700;
    color: var(--cat, var(--accent));
  }

  /* ---------- hover lift (standard / featured) ---------- */
  .standard .card-link,
  .featured .card-link {
    transition: transform 150ms ease;
  }

  .standard .card-link:hover,
  .featured .card-link:hover {
    transform: translateY(-2px);
  }

  .standard .card-link:hover .plate,
  .featured .card-link:hover .plate {
    box-shadow: var(--shadow-lift);
  }

  /* ---------- hero ---------- */
  .hero .card-link {
    display: grid;
    gap: 1.25rem;
  }

  .hero .plate {
    aspect-ratio: 3 / 2;
  }

  .hero .plate-day {
    font-size: clamp(3.5rem, 2.5rem + 4vw, 5.5rem);
  }

  .hero .title {
    font-size: var(--display-hero);
    line-height: 1.35;
    -webkit-line-clamp: 3;
  }

  .hero .lead {
    font-size: var(--text-base);
    -webkit-line-clamp: 3;
  }

  @media (min-width: 768px) {
    .hero .card-link {
      grid-template-columns: 3fr 2fr;
      align-items: center;
    }

    .hero .card-body {
      padding: 0;
    }
  }

  /* ---------- featured ---------- */
  .featured .plate {
    aspect-ratio: 21 / 9;
  }

  .featured .plate-day {
    font-size: 2.2rem;
  }

  .featured .title {
    font-size: var(--text-lg);
  }

  /* ---------- compact ---------- */
  .compact .card-link {
    display: flex;
    align-items: baseline;
    gap: 0.7rem;
    padding: 0.65rem 0.1rem;
    border-bottom: 1px solid var(--border-subtle);
  }

  .compact .card-body {
    display: contents;
  }

  .compact-date {
    font-size: var(--text-sm);
    color: var(--text-muted);
    font-variant-numeric: tabular-nums;
    flex-shrink: 0;
  }

  .cat-dot {
    width: 0.55em;
    height: 0.55em;
    background-color: var(--cat, var(--accent));
    flex-shrink: 0;
    align-self: center;
  }

  .compact .title {
    font-size: var(--text-base);
    font-weight: 600;
    -webkit-line-clamp: 2;
  }

  .compact .card-link:hover .title {
    text-decoration-thickness: 1.5px;
  }
</style>
