---
import type { Post } from "../utils/content";
import PostCard from "./PostCard.astro";
import SectionHeader from "./SectionHeader.astro";

interface Props {
  posts: Post[];
}

const { posts } = Astro.props;
---

{
  posts.length > 0 && (
    <section class="related" data-pagefind-ignore>
      <SectionHeader kicker="Related" title="関連記事" titleI18n="related.title" />
      <div class="related-list">
        {posts.map((post) => (
          <PostCard post={post} variant="compact" />
        ))}
      </div>
    </section>
  )
}

<style>
  .related {
    margin-top: 4rem;
  }

  .related-list {
    margin-top: 0.75rem;
  }
</style>
