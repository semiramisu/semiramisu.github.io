---
import Icon from "./Icon.astro";

interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl: string | undefined;
  nextUrl: string | undefined;
}

const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;

// compact window: 1 … c-1 c c+1 … last
const pages: (number | "…")[] = [];
for (let i = 1; i <= lastPage; i++) {
  if (i === 1 || i === lastPage || Math.abs(i - currentPage) <= 1) {
    pages.push(i);
  } else if (pages[pages.length - 1] !== "…") {
    pages.push("…");
  }
}

const pageUrl = (n: number) => (n === 1 ? "/" : `/${n}/`);
---

<nav class="pagination" aria-label="ページネーション">
  {
    prevUrl ? (
      <a href={prevUrl} class="page-nav" rel="prev" aria-label="前のページ">
        <Icon name="arrow-left" size={18} />
      </a>
    ) : (
      <span class="page-nav disabled" aria-hidden="true">
        <Icon name="arrow-left" size={18} />
      </span>
    )
  }
  <span class="pages">
    {
      pages.map((p) =>
        p === "…" ? (
          <span class="ellipsis">…</span>
        ) : p === currentPage ? (
          <span class="page current" aria-current="page">
            {p}
          </span>
        ) : (
          <a href={pageUrl(p)} class="page">
            {p}
          </a>
        ),
      )
    }
  </span>
  {
    nextUrl ? (
      <a href={nextUrl} class="page-nav" rel="next" aria-label="次のページ">
        <Icon name="arrow-right" size={18} />
      </a>
    ) : (
      <span class="page-nav disabled" aria-hidden="true">
        <Icon name="arrow-right" size={18} />
      </span>
    )
  }
</nav>

<style>
  .pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 3rem;
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .pages {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .page,
  .ellipsis {
    min-width: 2rem;
    text-align: center;
    padding: 0.25rem 0.35rem;
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }

  .page:hover {
    background-color: var(--bg-elevated);
    color: var(--text-primary);
  }

  /* current page = solid ink square, the editorial stamp */
  .page.current {
    color: var(--bg-base);
    background-color: var(--rule-ink);
    font-weight: 700;
  }

  .page-nav {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.2rem;
    height: 2.2rem;
    border: 1px solid var(--border-strong);
    border-radius: var(--radius-sm);
    color: var(--text-secondary);
  }

  .page-nav:hover {
    color: var(--accent);
    border-color: var(--accent);
  }

  .page-nav.disabled {
    color: var(--border-strong);
    border-color: var(--border-subtle);
  }
</style>
