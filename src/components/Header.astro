---
import { SITE, NAV_ITEMS } from "../site.config";
import Icon from "./Icon.astro";

const pathname = Astro.url.pathname;
const isCurrent = (href: string) =>
  href === "/" ? pathname === "/" : pathname.startsWith(href);
---

<header class="site-header">
  <div class="container header-inner">
    <a href="/" class="brand mono" aria-label={SITE.title}>
      <span class="brand-tilde">~/</span>{SITE.brand}
    </a>

    <nav class="desktop-nav mono" aria-label="メインナビゲーション">
      {
        NAV_ITEMS.map((item) => (
          <a
            href={item.href}
            class:list={["nav-link", { current: isCurrent(item.href) }]}
            aria-current={isCurrent(item.href) ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>

    <div class="header-actions">
      <a href="/search/" class="icon-button" aria-label="検索" data-i18n-aria="action.search">
        <Icon name="search" size={18} />
      </a>
      <button
        id="theme-toggle"
        class="icon-button mono"
        aria-label="テーマ切り替え"
        data-i18n-aria="action.theme"
      >
        <span aria-hidden="true">◐</span>
      </button>
      <button id="lang-toggle" class="icon-button mono lang-button" aria-label="Switch language">
        ja
      </button>
      <a href={SITE.github} class="icon-button external" rel="me noopener" target="_blank" aria-label="GitHub">
        <Icon name="github" size={18} />
      </a>
      <a href={SITE.x} class="icon-button external" rel="me noopener" target="_blank" aria-label="X (Twitter)">
        <Icon name="x" size={16} />
      </a>
      <button
        id="menu-open"
        class="icon-button mobile-only"
        aria-label="メニューを開く"
        aria-expanded="false"
        aria-controls="mobile-menu"
      >
        <Icon name="menu" size={20} />
      </button>
    </div>
  </div>
</header>

<div id="mobile-menu" class="mobile-menu" hidden>
  <div class="mobile-menu-header container">
    <a href="/" class="brand mono"><span class="brand-tilde">~/</span>{SITE.brand}</a>
    <button id="menu-close" class="icon-button" aria-label="メニューを閉じる">
      <Icon name="close" size={20} />
    </button>
  </div>
  <nav class="mobile-nav mono container" aria-label="モバイルナビゲーション">
    <a href="/" class:list={["mobile-link", { current: pathname === "/" }]}>home</a>
    {
      NAV_ITEMS.map((item) => (
        <a
          href={item.href}
          class:list={["mobile-link", { current: isCurrent(item.href) }]}
        >
          {item.label}
        </a>
      ))
    }
    <a href="/search/" class="mobile-link">search</a>
    <div class="mobile-social">
      <a href={SITE.github} rel="me noopener" target="_blank" aria-label="GitHub"><Icon name="github" /></a>
      <a href={SITE.x} rel="me noopener" target="_blank" aria-label="X (Twitter)"><Icon name="x" size={18} /></a>
    </div>
  </nav>
</div>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    height: var(--header-height);
    background-color: color-mix(in oklab, var(--bg-base) 85%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border-subtle);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: 1.5rem;
    height: 100%;
  }

  .brand {
    font-weight: 700;
    font-size: var(--text-base);
    color: var(--text-primary);
    flex-shrink: 0;
  }

  .brand-tilde {
    color: var(--accent);
  }

  .brand:hover {
    color: var(--accent-hover);
  }

  .desktop-nav {
    display: none;
    gap: 1.25rem;
    font-size: var(--text-sm);
    margin-left: auto;
  }

  .nav-link {
    color: var(--text-secondary);
    padding-block: 0.2rem;
  }

  .nav-link:hover {
    color: var(--text-primary);
  }

  .nav-link.current {
    color: var(--accent);
    border-bottom: 1px solid var(--accent);
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    margin-left: auto;
  }

  @media (min-width: 768px) {
    .desktop-nav {
      display: flex;
    }

    .header-actions {
      margin-left: 0;
    }

    .mobile-only {
      display: none;
    }
  }

  .icon-button {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.1rem;
    height: 2.1rem;
    border-radius: 6px;
    color: var(--text-secondary);
  }

  .icon-button:hover {
    color: var(--text-primary);
    background-color: var(--bg-elevated);
  }

  .lang-button {
    font-size: var(--text-xs);
    width: auto;
    padding-inline: 0.4rem;
  }

  @media (max-width: 480px) {
    .external {
      display: none;
    }
  }

  /* ---------- mobile menu ---------- */
  .mobile-menu {
    position: fixed;
    inset: 0;
    z-index: 60;
    background-color: var(--bg-surface);
    overflow-y: auto;
  }

  .mobile-menu-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    height: var(--header-height);
  }

  .mobile-nav {
    display: flex;
    flex-direction: column;
    gap: 0.25rem;
    padding-top: 1.5rem;
  }

  .mobile-link {
    font-size: var(--text-xl);
    color: var(--text-secondary);
    padding: 0.6rem 0;
  }

  .mobile-link::before {
    content: "> ";
    color: var(--border-strong);
  }

  .mobile-link.current {
    color: var(--accent);
  }

  .mobile-link.current::before,
  .mobile-link:hover::before {
    color: var(--accent);
  }

  .mobile-social {
    display: flex;
    gap: 1.25rem;
    margin-top: 2rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border-subtle);
  }

  .mobile-social a {
    color: var(--text-secondary);
  }

  .mobile-social a:hover {
    color: var(--text-primary);
  }
</style>

<script>
  // --- theme toggle ---
  const toggle = document.getElementById("theme-toggle");
  toggle?.addEventListener("click", () => {
    const root = document.documentElement;
    const next = root.dataset.theme === "dark" ? "light" : "dark";
    root.classList.add("theme-transition");
    root.dataset.theme = next;
    localStorage.setItem("theme", next);
    setTimeout(() => root.classList.remove("theme-transition"), 250);

    // keep giscus in sync
    const frame = document.querySelector<HTMLIFrameElement>("iframe.giscus-frame");
    frame?.contentWindow?.postMessage(
      { giscus: { setConfig: { theme: next } } },
      "https://giscus.app",
    );
  });

  // --- mobile menu ---
  const menu = document.getElementById("mobile-menu");
  const openButton = document.getElementById("menu-open");
  const closeButton = document.getElementById("menu-close");

  function setMenu(open: boolean) {
    if (!menu || !openButton) return;
    menu.hidden = !open;
    openButton.setAttribute("aria-expanded", String(open));
    document.body.style.overflow = open ? "hidden" : "";
  }

  openButton?.addEventListener("click", () => setMenu(true));
  closeButton?.addEventListener("click", () => setMenu(false));
  menu?.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("a")) setMenu(false);
  });
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape" && menu && !menu.hidden) setMenu(false);
  });
</script>
